# Data never goes in the repo (course rule: no data files in the submission)
*.svs
*.part
*.part.bad-*
raw/
state/
patches/
*.h5
*.zarr/

# Downloaded packages and the rclone config (it holds a sign-in token) live in data/; only the
# placeholder is tracked. The folder's contents are ignored, not the folder, so .gitkeep can be tracked.
/data/*
!/data/.gitkeep

# Run logs: ignored by default. Add the ones to submit explicitly:
#   git add -f logs/<file>.log
logs/

# Weights & Biases run files written next to the code
wandb/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# macOS
.DS_Store
